# Copie para .env e preencha. NUNCA commitar o .env.

# LLM: ollama | gemini | anthropic
LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct   # ponto de partida p/ 8 GB; testar modelos mais novos
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Instagram (Graph API)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_HOST=graph.facebook.com     # fluxo Facebook Login (o seu caso)
IG_GRAPH_VERSION=v23.0
# IG_ACCESS_TOKEN = token da PÁGINA (gerar com scripts/meta_token.py)
META_APP_ID=
META_APP_SECRET=

# Telegram (aprovação)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Túnel Cloudflare: o hostname do túnel deve apontar para http://public:80
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_BASE_URL=https://img.SEUDOMINIO.com

# Painel
APP_SECRET_KEY=            # >=16 caracteres aleatórios. Ex.: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_PASSWORD=            # senha do painel (>=8). Vira hash no primeiro boot; depois pode apagar daqui

# Valores abaixo só alimentam o perfil do Emerson na PRIMEIRA execução.
# Depois, edite tudo pelo painel (Perfis). O token fica criptografado no banco.
CARD_NAME=Emerson Assis
CARD_HANDLE=@seu_usuario
